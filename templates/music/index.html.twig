{% import 'music/_track_card.html.twig' as trackCard %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sinphony</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎵</text></svg>">
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <meta name="theme-color" content="#1db954">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Sinphony">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 180 180%22><text y=%22135%22 font-size=%22135%22>🎵</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

<div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="logo">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#1db954"/><polygon points="10,8 10,16 17,12" fill="white"/></svg>
            <span>Sinphony</span>
        </div>

        <nav class="sidebar-nav">
            <a href="#" class="nav-link active" id="nav-home" onclick="showView('home')">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Accueil</span>
            </a>
            <a href="#" class="nav-link" id="nav-search" onclick="showView('search')">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 1h-8C6.12 1 5 2.12 5 3.5v17C5 21.88 6.12 23 7.5 23h8c1.38 0 2.5-1.12 2.5-2.5v-17C18 2.12 16.88 1 15.5 1zm-4 21c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4.5-4H7V4h9v14z"/></svg>
                <span>Rechercher</span>
            </a>
            <a href="#" class="nav-link" id="nav-library" onclick="showView('library')">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h12v-2H3v2zM17 6v8.18c-.31-.11-.64-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z"/></svg>
                <span>Ma bibliothèque</span>
            </a>
            <a href="#" class="nav-link" id="nav-upload" onclick="showView('upload')">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"/></svg>
                <span>Ajouter de la musique</span>
            </a>
        </nav>

        <!-- Playing now mini info -->
        <div class="sidebar-now-playing" id="sidebar-now-playing" style="display:none">
            <div class="snp-cover" id="snp-cover"></div>
            <div class="snp-info">
                <span id="snp-title">—</span>
                <span id="snp-artist">—</span>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <main class="main">

        <!-- Home View -->
        <div id="view-home">
            <div class="home-hero">
                <div class="home-hero-content">
                    <span class="home-hero-badge">Rap Français</span>
                    <h1>Bienvenue sur Sinphony</h1>
                    <p>Écoute les meilleurs sons du rap FR — Kaaris, SCH, PNL, PLK et bien plus.</p>
                </div>
            </div>

            {% if featured is not empty %}
            <section class="home-section">
                <h2 class="home-section-title">🔥 Tendances</h2>
                <div class="home-row">
                    {% for track in featured %}
                        {{ trackCard.home_card(track) }}
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {% for artist, artistTracks in homeSections %}
            <section class="home-section">
                <h2 class="home-section-title">{{ artist }}</h2>
                <div class="home-row">
                    {% for track in artistTracks %}
                        {{ trackCard.home_card(track) }}
                    {% endfor %}
                </div>
            </section>
            {% endfor %}
        </div>

        <!-- Search View -->
        <div id="view-search" style="display:none">
            <div class="view-header">
                <h1>Rechercher</h1>
            </div>

            <div class="search-container">
                <div class="search-bar">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="color: #b3b3b3;"><path d="M15.5 1h-8C6.12 1 5 2.12 5 3.5v17C5 21.88 6.12 23 7.5 23h8c1.38 0 2.5-1.12 2.5-2.5v-17C18 2.12 16.88 1 15.5 1zm-4 21c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4.5-4H7V4h9v14z"/></svg>
                    <input type="text" id="search-input" placeholder="Titre, artiste..." class="search-input">
                </div>
                <div id="search-results" style="margin-top: 2rem;">
                    <p style="text-align: center; color: #888;">Commence à taper pour chercher</p>
                </div>
            </div>
        </div>

        <!-- Library View -->
        <div id="view-library" style="display:none">
            <div class="view-header">
                <h1>Ma bibliothèque</h1>
                <span class="track-count" id="track-count">{{ tracks|length }} morceau{% if tracks|length > 1 %}x{% endif %}</span>
            </div>

            {% if tracks is empty %}
            <div class="empty-state" id="empty-state">
                <div class="empty-icon">🎵</div>
                <h2>Ta bibliothèque est vide</h2>
                <p>Ajoute tes fichiers MP3, WAV, OGG ou FLAC<br>et écoute-les hors ligne, sans pub, à l'infini.</p>
                <button class="btn-primary" onclick="showView('upload')">Ajouter de la musique</button>
            </div>
            {% else %}
            <div class="track-list" id="track-list">
                {% for track in tracks %}
                <div class="track-item playable-track"
                     data-id="{{ track.id }}"
                     data-src="{{ path('app_music_stream', {filename: track.filename}) }}"
                     data-title="{{ track.title }}"
                     data-artist="{{ track.artist ?? 'Artiste inconnu' }}"
                     data-duration="{{ track.duration }}"
                     {% if track.coverPath %}data-cover="{{ asset(track.coverPath) }}"{% endif %}>
                    <div class="track-num">
                        <span class="mini-eq-num">{{ loop.index }}</span>
                        <span class="mini-eq"><span></span><span></span><span></span></span>
                    </div>
                    <div class="track-cover">
                        {% if track.coverPath %}
                            <img src="{{ asset(track.coverPath) }}" alt="">
                        {% else %}
                            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
                        {% endif %}
                    </div>
                    <div class="track-info">
                        <span class="track-title">{{ track.title }}</span>
                        <span class="track-artist">{{ track.artist ?? 'Artiste inconnu' }}{% if track.album %} • {{ track.album }}{% endif %}</span>
                    </div>
                    {% if track.genre %}
                    <span class="track-genre">{{ track.genre }}</span>
                    {% endif %}
                    <span class="track-dur">{% if track.duration %}{{ (track.duration // 60) ~ ':' ~ '%02d'|format(track.duration % 60) }}{% else %}—{% endif %}</span>
                    <button class="track-delete" data-id="{{ track.id }}" title="Supprimer">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                    </button>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <!-- Upload View -->
        <div id="view-upload" style="display:none">
            <div class="view-header">
                <h1>Ajouter de la musique</h1>
            </div>

            <!-- Spotify Import -->
            <div class="import-section spotify-section">
                <div class="import-section-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#1db954"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                    <span>Importer depuis Spotify</span>
                    <span class="import-badge">Track, Album ou Playlist</span>
                </div>
                <div class="import-input-group">
                    <input type="text" id="spotify-url" placeholder="Colle le lien d'un morceau Spotify..." class="import-input">
                    <button id="spotify-download-btn" class="btn-import btn-spotify">Importer</button>
                </div>
                <p class="import-hint">Ex: https://open.spotify.com/track/...</p>
                <div id="spotify-status" class="import-status" style="display:none;"></div>
            </div>

            <!-- Deezer Import -->
            <div class="import-section deezer-section">
                <div class="import-section-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#A238FF"><path d="M18.81 12.95H24v2.43h-5.19zm0-4.08H24v2.43h-5.19zm0-4.09H24v2.43h-5.19zm0 12.26H24v2.43h-5.19zM12.4 17.14h5.19v2.43H12.4zm0-4.09h5.19v2.43H12.4zm0-4.08h5.19v2.43H12.4zM6 17.14h5.19v2.43H6zm0-4.09h5.19v2.43H6zM0 17.14h5.19v2.43H0z"/></svg>
                    <span>Importer depuis Deezer</span>
                    <span class="import-badge">Track ou Playlist</span>
                </div>
                <div class="import-input-group">
                    <input type="text" id="deezer-url" placeholder="Lien Deezer (track ou playlist)..." class="import-input">
                    <button id="deezer-download-btn" class="btn-import btn-deezer">Importer</button>
                </div>
                <p class="import-hint">Ex: https://www.deezer.com/fr/track/... ou /playlist/...</p>
                <div id="deezer-status" class="import-status" style="display:none;"></div>

            </div>

            <!-- YouTube Import -->
            <div class="import-section youtube-section">
                <div class="import-section-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#ff0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    <span>Importer depuis YouTube</span>
                </div>
                <div class="import-input-group">
                    <input type="text" id="youtube-url" placeholder="Colle l'URL d'une vidéo YouTube..." class="import-input">
                    <button id="youtube-download-btn" class="btn-import btn-youtube">Importer</button>
                </div>
                <p class="import-hint">Ex: https://www.youtube.com/watch?v=...</p>
                <div id="youtube-status" class="import-status" style="display:none;"></div>
            </div>

            <div style="position: relative; text-align: center; margin: 2rem 0;">
                <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: #404040;"></div>
                <span style="position: relative; background: #181818; padding: 0 1rem; color: #888; font-size: 14px;">OU</span>
            </div>

            <div class="upload-zone" id="upload-zone">
                <div class="upload-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48"><path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" fill="#1db954"/></svg>
                </div>
                <h2>Glisse tes fichiers ici</h2>
                <p>MP3, WAV, OGG, FLAC — tous formats audio acceptés</p>
                <label class="btn-primary" for="file-input">Choisir des fichiers</label>
                <input type="file" id="file-input" accept="audio/*" multiple style="display:none">
            </div>

            <!-- Upload queue -->
            <div id="upload-queue" style="display:none">
                <h3>En cours d'import</h3>
                <div id="upload-items"></div>
            </div>
        </div>

    </main>
</div>

<!-- Player Bar -->
<div class="player" id="player" style="display:none;">
    <audio id="audio" playsinline></audio>

    <!-- Left: cover + info -->
    <div class="player-left">
        <div class="player-cover-wrap" id="player-cover-wrap">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        </div>
        <div class="player-track-info">
            <div class="player-title" id="player-title">Aucun morceau</div>
            <div class="player-artist" id="player-artist">—</div>
        </div>
        <div class="player-equalizer" id="player-equalizer">
            <span></span><span></span><span></span><span></span>
        </div>
    </div>

    <!-- Center: controls + timeline -->
    <div class="player-center">
        <div class="player-btns">
            <button class="p-btn" id="btn-shuffle" onclick="toggleShuffle()">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></svg>
            </button>
            <button class="p-btn" onclick="prevTrack()">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>
            <button class="p-btn play-btn" id="btn-play" onclick="togglePlay()">
                <svg id="icon-play" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M8 5v14l11-7z"/></svg>
                <svg id="icon-pause" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button class="p-btn" onclick="nextTrack()">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
            <button class="p-btn" id="btn-repeat" onclick="toggleRepeat()">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>
            </button>
        </div>
        <div class="player-timeline">
            <span id="time-current">0:00</span>
            <div class="progress-track" id="progress-track">
                <input type="range" id="progress-range" class="progress-range" min="0" max="1000" value="0" step="1">
            </div>
            <span id="time-total">0:00</span>
        </div>
    </div>

    <!-- Right: volume -->
    <div class="player-right">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
        <div class="volume-track" id="volume-track">
            <div class="volume-fill" id="volume-fill" style="width:70%"></div>
        </div>
    </div>
</div>

<script src="{{ asset('js/player.js') }}"></script>

<!-- Enregistrement Service Worker pour PWA offline + lecture arrière-plan -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then(reg => {
          console.log('✓ Service Worker enregistré, scope:', reg.scope);
          // Vérifier les mises à jour
          reg.addEventListener('updatefound', () => {
            console.log('🔄 Nouvelle version du Service Worker disponible');
          });
        })
        .catch(err => console.error('✗ Erreur Service Worker:', err));
    });
  }
</script>
</body>
</html>
